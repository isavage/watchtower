# Local development env file (copy to .env).
# In production these live in Doppler — the deploy action injects them with
# `doppler run -- docker compose up -d`, so no .env exists on the VPS.
WT_ADMIN_USER=admin
WT_ADMIN_PASSWORD=change-this-password
# 32+ random hex chars. Generate: openssl rand -hex 32
WT_SECRET_KEY=replace-with-a-long-random-secret
# Set true when serving behind a TLS reverse proxy
WT_COOKIE_SECURE=false
# Bearer token between the app and the host-proxy sidecar (generate another:
# openssl rand -hex 32). Both containers read the same value; endpoints on
# the proxy fail closed if it is unset.
WT_HOST_PROXY_TOKEN=replace-with-a-long-random-secret
# host-proxy allow/deny policy (1 = allow, 0 = deny). Denying SECURITY also
# means its /etc + /var/log mounts should be removed from docker-compose.yml.
WT_ALLOW_METRICS=1
WT_ALLOW_DETAILS=1
WT_ALLOW_SECURITY=1
# Websites page: parse per-site nginx access logs in the host-proxy. Set 0
# and remove the log mount from docker-compose.yml to deny it entirely.
WT_ALLOW_WEBSTATS=1
# App: seconds between nginx-log delta ingests into SQLite.
# WT_WEBSTATS_INTERVAL=60
# Proxy: MB of a first-seen log file parsed as history (rotation guard).
# WT_WEBSTATS_TAIL_MB=8
